# ─── Database ───────────────────────────────────────────────────────────────
# Neon PostgreSQL – use the "serverless" (pooled) connection string at runtime.
# Get from Neon console: Project → Connection string → Pooled connection
DATABASE_URL="postgresql://USER:PASSWORD@HOSTNAME/DBNAME?sslmode=require"

# Optional: separate migration role with stronger permissions (CREATE TABLE etc.)
# If omitted, DATABASE_URL is used for migrations too.
DATABASE_MIGRATION_URL="postgresql://MIGRATION_USER:PASSWORD@HOSTNAME/DBNAME?sslmode=require"

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS"

# The public URL of your deployment (no trailing slash)
# Local development:
BETTER_AUTH_URL="http://localhost:3001"
# Production (Vercel):
# BETTER_AUTH_URL="https://your-project.vercel.app"

# ─── Next.js public (safe to expose to browser) ──────────────────────────────
# The base URL used for API calls from the browser
NEXT_PUBLIC_APP_URL="http://localhost:3001"
